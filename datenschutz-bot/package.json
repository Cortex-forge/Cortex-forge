{
  "name": "datenschutz-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Datenschutz-Schleuse zwischen Dokumenten und KI: ersetzt personenbezogene Daten durch Platzhalter, die KI arbeitet nur mit Platzhaltern, danach werden die echten Daten wieder eingesetzt.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/web/server.js",
    "mcp": "node dist/mcp/server.js",
    "demo": "node dist/scripts/demo.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
